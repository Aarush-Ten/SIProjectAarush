# Copy to backend/.env. Run backend commands from backend/.
DATABASE_URL=sqlite:///./pathforge.db
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
LOG_LEVEL=INFO
ENVIRONMENT=development
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
# Production: ENVIRONMENT=production, exact public ALLOWED_HOSTS and HTTPS CORS_ORIGINS.
# Public API docs remain off in production unless EXPOSE_API_DOCS=true.
MAX_REQUEST_BYTES=65536
REQUEST_BODY_TIMEOUT_SECONDS=10
API_REQUESTS_PER_MINUTE=600
ADMIN_FAILURES_PER_MINUTE=20

# Copy the following setting to frontend/.env.local.
# This public URL contains no credentials. Restart/rebuild Next.js after changes.
NEXT_PUBLIC_API_URL=http://localhost:8000

# The deterministic core requires no AI API key. Optional Phase 3 settings are backend-only.

# Optional backend-only expert administrator token (random, at least 32 characters).
# Omit to disable administration. Never expose through NEXT_PUBLIC variables.
# ADMIN_TOKEN=generate_a_random_secret_locally

# Optional AI wording. Disabled by default; no provider request without UI consent.
AI_PROVIDER=none
# AI_PROVIDER=gemini
# AI_API_KEY=set_only_in_backend_environment
# AI_MODEL=choose_a_structured_output_model_available_in_your_provider_account
AI_TIMEOUT_SECONDS=8
AI_REQUESTS_PER_MINUTE=5
AI_REQUESTS_PER_DAY=100
