{
  "name": "pathforge-ai",
  "version": "0.1.0",
  "private": true,
  "description": "CYBERSTARS Phases 1 and 2: deterministic career exploration and local learning plans",
  "scripts": {
    "submission:package": "node scripts/submission.mjs",
    "submission:check": "node scripts/submission.mjs --check",
    "submission:test": "node scripts/submission.mjs --test",
    "check": "node scripts/check.mjs",
    "check:e2e": "node scripts/check.mjs --e2e",
    "check:deployment": "node scripts/check-deployment.mjs",
    "dev:frontend": "npm --prefix frontend run dev",
    "test:frontend": "npm --prefix frontend test",
    "test:e2e": "npm --prefix frontend run test:e2e",
    "types:api": "npm --prefix frontend run types:api"
  },
  "engines": { "node": "^22.12.0 || ^24.0.0 || >=26.0.0" }
}
